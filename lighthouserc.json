{
  "ci": {
    "collect": {
      "startServerCommand": "npm run preview -- --port 4180 --strictPort",
      "url": ["http://127.0.0.1:4180/"],
      "numberOfRuns": 3,
      "startServerReadyPattern": "Local:"
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "error",
          {
            "minScore": 0.9
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:best-practices": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:seo": [
          "error",
          {
            "minScore": 0.9
          }
        ]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".cache/lighthouse"
    }
  }
}
