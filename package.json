{
  "name": "grillizia",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "brand": "node --experimental-strip-types scripts/generate-brand.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc -b",
    "test": "node scripts/test.mjs",
    "check": "npm run lint && npm run typecheck && npm test && npm run contrast",
    "format": "prettier --write src tests scripts *.json *.ts *.md",
    "format:check": "prettier --check src tests scripts *.json *.ts *.md",
    "images": "node scripts/optimize-images.mjs",
    "references": "node scripts/analyze-references.mjs",
    "contrast": "node scripts/check-contrast.mjs",
    "test:e2e": "playwright test",
    "lighthouse": "lhci autorun",
    "rehearse": "node scripts/rehearse.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.2.8",
    "@fontsource-variable/oswald": "5.2.8",
    "@fontsource/ibm-plex-mono": "5.2.7",
    "@radix-ui/react-dialog": "1.1.15",
    "@radix-ui/react-tabs": "1.1.13",
    "@radix-ui/react-toast": "1.2.15",
    "@hookform/resolvers": "5.2.2",
    "date-fns": "4.1.0",
    "framer-motion": "12.23.24",
    "lucide-react": "0.468.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-hook-form": "7.65.0",
    "react-router-dom": "6.30.1",
    "zod": "4.1.12",
    "zustand": "5.0.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@eslint/js": "9.39.1",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.56.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "22.19.0",
    "@types/react": "18.3.26",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "autoprefixer": "10.4.22",
    "eslint": "9.39.1",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-react-refresh": "0.4.24",
    "ffmpeg-static": "5.2.0",
    "globals": "16.5.0",
    "jsdom": "26.1.0",
    "postcss": "8.5.6",
    "prettier": "3.6.2",
    "sharp": "0.34.4",
    "tailwindcss": "3.4.18",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.2",
    "vite": "6.4.1",
    "vite-plugin-pwa": "1.1.0",
    "vitest": "3.2.4"
  },
  "overrides": {
    "playwright": "1.56.1",
    "playwright-core": "1.56.1"
  }
}
